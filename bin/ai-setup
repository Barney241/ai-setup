#!/usr/bin/env bash
set -euo pipefail

AI_SETUP_DIR="${AI_SETUP_DIR:-$HOME/Projects/personal/ai-setup}"
AI_SETUP_REPO="${AI_SETUP_REPO:-https://github.com/Barney241/ai-setup.git}"
AI_SETUP_BRANCH="${AI_SETUP_BRANCH:-main}"
AI_SETUP_FLEET="${AI_SETUP_FLEET:-}"
AI_SETUP_TELEMETRY_ENDPOINT="${AI_SETUP_TELEMETRY_ENDPOINT:-}"
AI_SETUP_TELEMETRY_QUERY_URL="${AI_SETUP_TELEMETRY_QUERY_URL:-}"
AI_SETUP_TELEMETRY_CONTENT="${AI_SETUP_TELEMETRY_CONTENT:-false}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ai-setup"
SKILL_TARGETS=("$HOME/.claude/skills" "$HOME/.agents/skills")
AGENT_TARGET="$HOME/.claude/agents"
GLOBAL_RULES="$AI_SETUP_DIR/global/AGENTS.md"
CLAUDE_SETTINGS="$HOME/.claude/settings.json"
CODEX_CONFIG="$HOME/.codex/config.toml"
CODEX_TELEMETRY_BEGIN="# ai-setup telemetry begin"
CODEX_TELEMETRY_END="# ai-setup telemetry end"
CLAUDE_TELEMETRY_KEYS=(
  CLAUDE_CODE_ENABLE_TELEMETRY
  CLAUDE_CODE_ENHANCED_TELEMETRY_BETA
  OTEL_METRICS_EXPORTER
  OTEL_LOGS_EXPORTER
  OTEL_TRACES_EXPORTER
  OTEL_EXPORTER_OTLP_PROTOCOL
  OTEL_EXPORTER_OTLP_ENDPOINT
  OTEL_RESOURCE_ATTRIBUTES
  OTEL_LOG_TOOL_DETAILS
  OTEL_LOG_USER_PROMPTS
  OTEL_LOG_ASSISTANT_RESPONSES
  OTEL_LOG_TOOL_CONTENT
)

say() { printf 'ai-setup: %s\n' "$*"; }
warn() { printf 'ai-setup: warning: %s\n' "$*" >&2; }
die() { printf 'ai-setup: error: %s\n' "$*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }
git_in() { git -C "$AI_SETUP_DIR" "$@"; }

usage() {
  cat <<EOF
usage: ai-setup <command>

  setup           one-time per host: sync, sign in to gh, Claude, Codex, Antigravity, check fleet SSH
  sync            clone if missing, fast-forward from origin, relink, refresh plugin and MCP
  link            relink skills, agents and global rules from the checkout (no network)
  push [message]  commit local edits, rebase on origin, push, then sync the fleet
  fleet           trigger a sync on every other host in AI_SETUP_FLEET
  query <sql>     run read-only SQL against the fleet telemetry store
  report [name] [days]  run a telemetry report, or list them
  status          checkout state, last sync, linked skills
  doctor          check tools, auth and links on this host
  path            print the checkout path

checkout: $AI_SETUP_DIR
fleet:    ${AI_SETUP_FLEET:-<none>}
telemetry: ${AI_SETUP_TELEMETRY_ENDPOINT:-<off>}
EOF
}

points_into_checkout() {
  [ -L "$1" ] && case "$(readlink "$1")" in "$AI_SETUP_DIR"/*) return 0 ;; esac
  return 1
}

place_link() {
  local source="$1" target="$2"
  if points_into_checkout "$target" && [ "$(readlink "$target")" = "$source" ]; then
    return 0
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then
    if points_into_checkout "$target"; then
      ln -sfn "$source" "$target"
      return 0
    fi
    warn "skipping $target: exists and is not managed by ai-setup"
    return 0
  fi
  mkdir -p "$(dirname "$target")"
  ln -s "$source" "$target"
}

prune_dangling() {
  local dir="$1" entry
  [ -d "$dir" ] || return 0
  for entry in "$dir"/* "$dir"/.[!.]*; do
    if points_into_checkout "$entry" && [ ! -e "$entry" ]; then
      unlink "$entry"
      say "removed stale link $entry"
    fi
  done
}

link_skills() {
  local skill target_dir
  for target_dir in "${SKILL_TARGETS[@]}"; do
    mkdir -p "$target_dir"
    for skill in "$AI_SETUP_DIR"/skills/*/; do
      [ -f "$skill/SKILL.md" ] || continue
      skill="${skill%/}"
      place_link "$skill" "$target_dir/$(basename "$skill")"
    done
    prune_dangling "$target_dir"
  done
}

link_agents() {
  local agent
  mkdir -p "$AGENT_TARGET"
  for agent in "$AI_SETUP_DIR"/agents/*.md; do
    [ -f "$agent" ] || continue
    place_link "$agent" "$AGENT_TARGET/$(basename "$agent")"
  done
  prune_dangling "$AGENT_TARGET"
}

link_rules_file() {
  local target="$1"
  if [ -f "$target" ] && [ ! -L "$target" ] && [ ! -s "$target" ]; then
    unlink "$target"
  fi
  place_link "$GLOBAL_RULES" "$target"
}

import_rules_into_claude() {
  local claude_md="$HOME/.claude/CLAUDE.md" line="@$GLOBAL_RULES"
  mkdir -p "$HOME/.claude"
  if [ -f "$claude_md" ] && grep -qxF "$line" "$claude_md"; then
    return 0
  fi
  if [ -s "$claude_md" ]; then
    printf '%s\n\n%s' "$line" "$(cat "$claude_md")" > "$claude_md.ai-setup-tmp"
    printf '\n' >> "$claude_md.ai-setup-tmp"
    mv "$claude_md.ai-setup-tmp" "$claude_md"
  else
    printf '%s\n' "$line" > "$claude_md"
  fi
  say "imported global rules into $claude_md"
}

link_global_rules() {
  [ -f "$GLOBAL_RULES" ] || return 0
  import_rules_into_claude
  link_rules_file "$HOME/.codex/AGENTS.md"
  link_rules_file "$HOME/.gemini/GEMINI.md"
}

cmd_link() {
  [ -d "$AI_SETUP_DIR/.git" ] || die "no checkout at $AI_SETUP_DIR; run 'ai-setup sync'"
  link_skills
  link_agents
  link_global_rules
}

ensure_checkout() {
  [ -d "$AI_SETUP_DIR/.git" ] && return 0
  mkdir -p "$(dirname "$AI_SETUP_DIR")"
  git clone --quiet --branch "$AI_SETUP_BRANCH" "$AI_SETUP_REPO" "$AI_SETUP_DIR"
  say "cloned $AI_SETUP_REPO into $AI_SETUP_DIR"
}

fast_forward() {
  local upstream="origin/$AI_SETUP_BRANCH"
  git_in fetch --quiet origin "$AI_SETUP_BRANCH" || { warn "fetch failed; keeping current checkout"; return 0; }
  if [ -n "$(git_in status --porcelain)" ]; then
    warn "local edits in $AI_SETUP_DIR; not pulling (ship them with 'ai-setup push')"
    return 0
  fi
  if [ "$(git_in rev-parse HEAD)" = "$(git_in rev-parse "$upstream")" ]; then
    return 0
  fi
  if git_in merge-base --is-ancestor HEAD "$upstream"; then
    git_in merge --quiet --ff-only "$upstream"
    say "updated to $(git_in log -1 --format='%h %s')"
  elif git_in merge-base --is-ancestor "$upstream" HEAD; then
    warn "checkout is ahead of $upstream; run 'ai-setup push'"
  else
    warn "checkout has diverged from $upstream; resolve by hand in $AI_SETUP_DIR"
  fi
}

installed_plugin_commit() {
  jq -r '.plugins["ai-setup@ai-setup"][0].gitCommitSha // empty' "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null || true
}

plugin_is_current() {
  local installed
  installed="$(installed_plugin_commit)"
  [ -n "$installed" ] || return 1
  git_in cat-file -e "$installed^{commit}" 2>/dev/null || return 1
  git_in diff --quiet "$installed" HEAD -- plugin .claude-plugin
}

refresh_claude_plugin() {
  has claude || return 0
  plugin_is_current && return 0
  if claude plugin marketplace list 2>/dev/null | grep -q 'ai-setup'; then
    claude plugin marketplace update ai-setup >/dev/null 2>&1 || true
  else
    claude plugin marketplace add "$AI_SETUP_DIR" >/dev/null || { warn "could not add the ai-setup plugin marketplace"; return 0; }
  fi
  claude plugin uninstall ai-setup@ai-setup >/dev/null 2>&1 || true
  if claude plugin install ai-setup@ai-setup >/dev/null; then
    say "installed ai-setup plugin at $(git_in rev-parse --short HEAD)"
  else
    warn "ai-setup plugin install failed"
  fi
}

register_codex_mcp() {
  has codex || return 0
  if has playwright-mcp && ! codex mcp get playwright >/dev/null 2>&1; then
    codex mcp add playwright -- playwright-mcp --headless >/dev/null && say "registered playwright MCP for codex"
  fi
  if [ -n "$AI_SETUP_TELEMETRY_QUERY_URL" ] && ! codex mcp get ai-setup-telemetry >/dev/null 2>&1; then
    codex mcp add ai-setup-telemetry -- ai-setup telemetry-mcp >/dev/null && say "registered telemetry MCP for codex"
  fi
  return 0
}

register_antigravity_mcp() {
  has agy || return 0
  local registered
  registered="$(agy mcp list 2>/dev/null || true)"
  if has playwright-mcp && ! grep -q 'playwright' <<<"$registered"; then
    agy mcp add playwright playwright-mcp --headless >/dev/null 2>&1 && say "registered playwright MCP for antigravity"
  fi
  if [ -n "$AI_SETUP_TELEMETRY_QUERY_URL" ] && ! grep -q 'ai-setup-telemetry' <<<"$registered"; then
    agy mcp add ai-setup-telemetry ai-setup telemetry-mcp >/dev/null 2>&1 && say "registered telemetry MCP for antigravity"
  fi
  return 0
}

claude_telemetry_env() {
  [ -n "$AI_SETUP_TELEMETRY_ENDPOINT" ] || { printf '{}'; return 0; }
  jq -n \
    --arg endpoint "$AI_SETUP_TELEMETRY_ENDPOINT" \
    --arg resource "host.name=$(uname -n)" \
    --argjson content "$AI_SETUP_TELEMETRY_CONTENT" '
    {
      CLAUDE_CODE_ENABLE_TELEMETRY: "1",
      CLAUDE_CODE_ENHANCED_TELEMETRY_BETA: "1",
      OTEL_METRICS_EXPORTER: "otlp",
      OTEL_LOGS_EXPORTER: "otlp",
      OTEL_TRACES_EXPORTER: "otlp",
      OTEL_EXPORTER_OTLP_PROTOCOL: "http/protobuf",
      OTEL_EXPORTER_OTLP_ENDPOINT: $endpoint,
      OTEL_RESOURCE_ATTRIBUTES: $resource,
      OTEL_LOG_TOOL_DETAILS: "1"
    } + (if $content then {
      OTEL_LOG_USER_PROMPTS: "1",
      OTEL_LOG_ASSISTANT_RESPONSES: "1",
      OTEL_LOG_TOOL_CONTENT: "1"
    } else {} end)'
}

configure_claude_telemetry() {
  local wanted managed updated
  if [ -L "$CLAUDE_SETTINGS" ]; then
    [ -z "$AI_SETUP_TELEMETRY_ENDPOINT" ] || warn "skipping $CLAUDE_SETTINGS: it is a symlink"
    return 0
  fi
  if [ ! -f "$CLAUDE_SETTINGS" ]; then
    [ -n "$AI_SETUP_TELEMETRY_ENDPOINT" ] || return 0
    mkdir -p "$(dirname "$CLAUDE_SETTINGS")"
    printf '{}\n' > "$CLAUDE_SETTINGS"
  fi
  wanted="$(claude_telemetry_env)"
  managed="$(printf '%s\n' "${CLAUDE_TELEMETRY_KEYS[@]}" | jq -R . | jq -s .)"
  updated="$(mktemp "$CLAUDE_SETTINGS.XXXXXX")"
  if ! jq --argjson wanted "$wanted" --argjson managed "$managed" '
    (.["env"] // {} | with_entries(select(.key as $key | $managed | index($key) | not))) as $kept
    | .["env"] = $kept + $wanted
    | if .["env"] == {} then del(.["env"]) else . end
  ' "$CLAUDE_SETTINGS" > "$updated"; then
    unlink "$updated"
    warn "could not parse $CLAUDE_SETTINGS; telemetry not configured for Claude"
    return 0
  fi
  if jq -e --slurpfile current "$CLAUDE_SETTINGS" '. == $current[0]' "$updated" >/dev/null; then
    unlink "$updated"
    return 0
  fi
  chmod --reference="$CLAUDE_SETTINGS" "$updated"
  mv "$updated" "$CLAUDE_SETTINGS"
  say "updated Claude telemetry settings"
}

codex_telemetry_block() {
  local endpoint="$AI_SETUP_TELEMETRY_ENDPOINT"
  cat <<EOF
$CODEX_TELEMETRY_BEGIN
[otel]
environment = "$(uname -n)"
log_user_prompt = $AI_SETUP_TELEMETRY_CONTENT
exporter = { otlp-http = { endpoint = "$endpoint/v1/logs", protocol = "binary" } }
trace_exporter = { otlp-http = { endpoint = "$endpoint/v1/traces", protocol = "binary" } }
metrics_exporter = { otlp-http = { endpoint = "$endpoint/v1/metrics", protocol = "binary" } }
$CODEX_TELEMETRY_END
EOF
}

configure_codex_telemetry() {
  local unmanaged updated
  [ -f "$CODEX_CONFIG" ] || return 0
  unmanaged="$(sed "/^$CODEX_TELEMETRY_BEGIN\$/,/^$CODEX_TELEMETRY_END\$/d" "$CODEX_CONFIG")"
  if [ -n "$AI_SETUP_TELEMETRY_ENDPOINT" ] && grep -q '^\[otel\]' <<<"$unmanaged"; then
    warn "skipping $CODEX_CONFIG: it already has its own [otel] table"
    return 0
  fi
  updated="$(mktemp "$CODEX_CONFIG.XXXXXX")"
  printf '%s\n' "$unmanaged" > "$updated"
  if [ -n "$AI_SETUP_TELEMETRY_ENDPOINT" ]; then
    { printf '\n'; codex_telemetry_block; } >> "$updated"
  fi
  if [ "$(sed '/^$/d' "$updated")" = "$(sed '/^$/d' "$CODEX_CONFIG")" ]; then
    unlink "$updated"
    return 0
  fi
  chmod --reference="$CODEX_CONFIG" "$updated"
  mv "$updated" "$CODEX_CONFIG"
  say "updated Codex telemetry settings"
}

telemetry_request() {
  local sql="$1" params="${2:-}"
  [ -n "$AI_SETUP_TELEMETRY_QUERY_URL" ] || die "telemetry is not configured on this host"
  curl --silent --show-error --fail-with-body --max-time 70 \
    "$AI_SETUP_TELEMETRY_QUERY_URL/?user=agent&default_format=TSVWithNames$params" \
    --data-binary "$sql"
}

cmd_query() {
  [ "$#" -eq 1 ] || die "usage: ai-setup query <sql>"
  telemetry_request "$1"
}

list_reports() {
  local report
  for report in "$AI_SETUP_DIR"/telemetry/reports/*.sql; do
    basename "$report" .sql
  done
}

cmd_report() {
  local name="${1:-}" days="${2:-7}" file
  [ -n "$name" ] || { list_reports; return 0; }
  case "$name" in *[!a-z-]*) die "unknown report: $name" ;; esac
  file="$AI_SETUP_DIR/telemetry/reports/$name.sql"
  [ -f "$file" ] || die "unknown report: $name"
  case "$days" in '' | *[!0-9]*) die "days must be a number" ;; esac
  telemetry_request "$(cat "$file")" "&param_days=$days"
}

cmd_telemetry_mcp() {
  exec python3 "$AI_SETUP_DIR/telemetry/mcp_server.py"
}

record_sync() {
  mkdir -p "$STATE_DIR"
  printf '%s %s\n' "$(date -Iseconds)" "$(git_in rev-parse --short HEAD)" > "$STATE_DIR/last-sync"
}

cmd_sync() {
  ensure_checkout
  fast_forward
  cmd_link
  refresh_claude_plugin
  register_codex_mcp
  register_antigravity_mcp
  configure_claude_telemetry
  configure_codex_telemetry
  record_sync
}

sign_in() {
  local label="$1" probe="$2" login="$3"
  if ! has "${probe%% *}"; then
    printf '  skip  %s: %s is not installed on this host\n' "$label" "${probe%% *}"
    return 0
  fi
  if sh -c "$probe" >/dev/null 2>&1; then
    printf '  ok    %s\n' "$label"
    return 0
  fi
  printf '\n%s is not signed in. Running: %s\n' "$label" "$login"
  sh -c "$login" || warn "$label sign-in did not finish; rerun 'ai-setup setup' later"
}

check_fleet_ssh() {
  local host self
  self="$(uname -n)"
  for host in $AI_SETUP_FLEET; do
    [ "$host" = "$self" ] && continue
    if ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" true 2>/dev/null; then
      printf '  ok    ssh %s\n' "$host"
    else
      printf '  FAIL  ssh %s: key auth over the tailnet failed; try ssh-copy-id %s\n' "$host" "$host"
    fi
  done
}

cmd_setup() {
  [ -t 0 ] || die "setup signs you in interactively; run it in a terminal"
  say "syncing skills"
  cmd_sync
  printf '\nsign-ins\n'
  sign_in "GitHub CLI" "gh auth status" "gh auth login --web --git-protocol https && gh auth setup-git"
  sign_in "Claude Code" "claude auth status" "claude auth login"
  sign_in "Codex (GPT Sol seat)" "codex login status" "codex login"
  sign_in "Antigravity CLI (Gemini seat)" "agy models" "echo 'Sign in in the browser, then type /exit.' && agy"
  register_antigravity_mcp
  printf '\nfleet\n'
  check_fleet_ssh
  printf '\nT3 Code\n'
  if has agy_acp_server.par; then
    printf '  ok    Antigravity ACP server on PATH; restart T3 Code, then sign in under Settings > Providers > Antigravity\n'
  else
    printf '  FAIL  agy_acp_server.par missing: enable roles.llm-tools in infinity-lab and rebuild\n'
  fi
  printf '\n'
  cmd_doctor
}

cmd_push() {
  local message="${1:-ai-setup: update from $(uname -n)}"
  [ -d "$AI_SETUP_DIR/.git" ] || die "no checkout at $AI_SETUP_DIR"
  if [ -n "$(git_in status --porcelain)" ]; then
    git_in add -A
    git_in commit --quiet -m "$message"
    say "committed: $message"
  fi
  git_in pull --quiet --rebase origin "$AI_SETUP_BRANCH"
  git_in push --quiet origin "HEAD:$AI_SETUP_BRANCH"
  say "pushed $(git_in log -1 --format='%h %s')"
  cmd_link
  record_sync
  cmd_fleet
}

sync_remote() {
  local host="$1"
  if ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" 'systemctl --user start ai-setup-sync.service' 2>/dev/null; then
    printf '  %-12s synced\n' "$host"
  else
    printf '  %-12s unreachable or failed (it will catch up on its timer)\n' "$host"
  fi
}

cmd_fleet() {
  local host self pids=()
  self="$(uname -n)"
  [ -n "$AI_SETUP_FLEET" ] || { say "no fleet configured"; return 0; }
  say "syncing fleet"
  for host in $AI_SETUP_FLEET; do
    [ "$host" = "$self" ] && continue
    sync_remote "$host" &
    pids+=("$!")
  done
  [ "${#pids[@]}" -eq 0 ] || wait "${pids[@]}"
}

count_links() {
  local dir="$1" entry count=0
  for entry in "$dir"/*; do
    points_into_checkout "$entry" && count=$((count + 1))
  done
  printf '%s' "$count"
}

cmd_status() {
  [ -d "$AI_SETUP_DIR/.git" ] || die "no checkout at $AI_SETUP_DIR; run 'ai-setup sync'"
  local counts
  counts="$(git_in rev-list --left-right --count "HEAD...origin/$AI_SETUP_BRANCH" 2>/dev/null || printf '? ?')"
  printf 'checkout   %s\n' "$AI_SETUP_DIR"
  printf 'head       %s\n' "$(git_in log -1 --format='%h %s (%cr)')"
  printf 'ahead      %s  behind %s (as of last fetch)\n' "${counts%%[[:space:]]*}" "${counts##*[[:space:]]}"
  printf 'local edits %s\n' "$([ -n "$(git_in status --porcelain)" ] && echo yes || echo no)"
  printf 'last sync  %s\n' "$(cat "$STATE_DIR/last-sync" 2>/dev/null || echo never)"
  printf 'skills     claude %s, agents %s\n' "$(count_links "$HOME/.claude/skills")" "$(count_links "$HOME/.agents/skills")"
  printf 'subagents  %s\n' "$(count_links "$AGENT_TARGET")"
  printf 'fleet      %s\n' "${AI_SETUP_FLEET:-<none>}"
  printf 'telemetry  %s\n' "${AI_SETUP_TELEMETRY_ENDPOINT:-<off>}"
}

check() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf '  ok    %s\n' "$label"
  else
    printf '  FAIL  %s\n' "$label"
  fi
}

cmd_doctor() {
  local tool
  printf 'tools\n'
  for tool in git gh jq python3 node playwright playwright-mcp claude codex agy agy_acp_server.par; do
    check "$tool" has "$tool"
  done
  printf 'auth\n'
  check "gh auth" gh auth status
  has codex && check "codex login" codex login status
  printf 'browser\n'
  check "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH" test -x "${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-/nonexistent}"
  printf 'links\n'
  check "checkout" test -d "$AI_SETUP_DIR/.git"
  check "claude imports global rules" grep -qxF "@$GLOBAL_RULES" "$HOME/.claude/CLAUDE.md"
  check "codex global rules" points_into_checkout "$HOME/.codex/AGENTS.md"
  check "gemini global rules" points_into_checkout "$HOME/.gemini/GEMINI.md"
  has claude && check "claude plugin" sh -c 'claude plugin list 2>/dev/null | grep -q ai-setup@ai-setup'
  if grep -qs 'hooks/load-project-direnv.sh' "$HOME/.claude/settings.json"; then
    printf '  WARN  ~/.claude/settings.json still runs load-project-direnv.sh; the ai-setup plugin runs it too\n'
  fi
  [ -n "$AI_SETUP_TELEMETRY_ENDPOINT" ] || return 0
  printf 'telemetry\n'
  check "claude export configured" grep -qF "$AI_SETUP_TELEMETRY_ENDPOINT" "$CLAUDE_SETTINGS"
  check "codex export configured" grep -qxF "$CODEX_TELEMETRY_BEGIN" "$CODEX_CONFIG"
  check "ingest reachable" curl --silent --output /dev/null --max-time 5 "$AI_SETUP_TELEMETRY_ENDPOINT/v1/logs"
  check "store reachable" telemetry_request 'SELECT 1'
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    setup) cmd_setup ;;
    sync) cmd_sync ;;
    link) cmd_link ;;
    push) cmd_push "$@" ;;
    fleet) cmd_fleet ;;
    query) cmd_query "$@" ;;
    report) cmd_report "$@" ;;
    telemetry-mcp) cmd_telemetry_mcp ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    path) printf '%s\n' "$AI_SETUP_DIR" ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
